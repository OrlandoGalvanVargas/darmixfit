<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DarmixFit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/darmix_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.DarmixFit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/darmix_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.DarmixFit</item>
    </style>

</resources>
