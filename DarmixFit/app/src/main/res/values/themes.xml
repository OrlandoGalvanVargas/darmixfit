<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal de la app (sin ActionBar) -->
    <style name="Theme.FitFLow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fitflow_background</item>
    </style>

    <!-- Tema del splash nativo (Android 12+ y fallback) -->
    <style name="Theme.FitFLow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fitflow_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.FitFLow</item>
    </style>

</resources>