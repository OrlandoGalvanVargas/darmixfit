<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo Base Oscuro (BackgroundDark: #0E0F11) -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0E0F11" />

    <!-- Degradado ambiental superior (Luz tenue de arriba hacia abajo) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:color="#1A1F13" android:offset="0.0" />
                <item android:color="#0E0F11" android:offset="0.7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor central en tono Lima (Aumento de opacidad y radio para más brillo) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="58">
                <item android:color="#354410" android:offset="0.0" />
                <item android:color="#1B220B" android:offset="0.5" />
                <item android:color="#000E0F11" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bisel concéntrico discreto para acentuar el centro -->
    <path
        android:pathData="M 54,54 m -40,0 a 40,40 0 1,0 80,0 a 40,40 0 1,0 -80,0"
        android:strokeColor="#2A321B"
        android:strokeWidth="1.2"
        android:fillColor="#00000000" />
</vector>