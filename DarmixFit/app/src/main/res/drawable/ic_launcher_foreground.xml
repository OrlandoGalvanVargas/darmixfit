                android:type="linear"
                android:startX="30"
                android:startY="20"
                android:endX="78"
                android:endY="78">
                <item android:color="#C6FF3D" android:offset="0.0" />
                <item android:color="#8FBF2E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Punto Ámbar en el extremo -->
    <path
        android:pathData="M 78,78 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0"
        android:fillColor="#FFB020" />

    <!-- MANCUERNA EN EL CENTRO -->

