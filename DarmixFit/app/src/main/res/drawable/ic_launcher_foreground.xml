        android:pathData="M 39,61 L 47,69"
        android:strokeColor="#F5F6F7"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Disco Exterior Izquierdo (Lima) -->
    <path
        android:pathData="M 36,64 L 44,72"
        android:strokeColor="#C6FF3D"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- Disco Interior Derecho -->
    <path
        android:pathData="M 61,39 L 69,47"
        android:strokeColor="#F5F6F7"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Disco Exterior Derecho (Lima) -->
    <path
        android:pathData="M 64,36 L 72,44"
