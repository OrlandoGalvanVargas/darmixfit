    <!-- Anillo de descanso MÁS GRUESO con degradado dinámico (LimeAccent a LimeAccentDim) -->
    <path
        android:pathData="M 30,78 A 33.5,33.5 0 1,1 78,78"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
